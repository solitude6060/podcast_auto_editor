# Copy to .env for local Docker Compose runs. Do not commit .env.

# Optional non-local fallback only. Leave empty for local-first default behavior.
MINIMAX_API_KEY=

# Local model and whisper.cpp mounts. Model files and binaries are not committed.
LOCAL_MODELS_DIR=./models
WHISPER_CPP_BIN_DIR=./third_party/whisper.cpp/build/bin
WHISPER_CPP_BINARY=/opt/whisper.cpp/bin/whisper-cli
WHISPER_CPP_MODEL_PATH=/models/ggml-large-v3-q5_0.bin

# Ollama runtime tuning for a single RTX 4090 workstation.
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_PARALLEL=1
